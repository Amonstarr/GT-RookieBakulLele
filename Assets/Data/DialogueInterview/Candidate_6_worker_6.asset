  m_Script: {fileID: 11500000, guid: 5c60c8e966f79564ba165beefdd93b01, type: 3}
  m_Name: Candidate_6_worker_6
  m_EditorClassIdentifier: Assembly-CSharp::GT.Dialogue.Data.CandidateInterviewScriptSO
  candidateId: worker_6
  candidateName: Alstena Reszwki
  candidateBio: 
  defaultPortrait: {fileID: 7480188237302958220, guid: 60ba0c9465688554fa38441a40f1e421, type: 3}
  cvDocumentSprite: {fileID: -438266656303300566, guid: 21a2964e4e18fdb418198a390920664f, type: 3}
  dialogueLines:
  - speakerName: Alstena Reszwki
    dialogueText: Hai, hai! Perkenalkan, saya Alstena Reszwki.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Alstena Reszwki
    dialogueText: Saya punya pengalaman dan kemampuan di beberapa bidang, jadi saya
      cukup fleksibel kalau harus mengerjakan hal yang berbeda-beda.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: Oke... baik, Alstena Resz, Reszw?... Reszwki
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: ..Maaf. Nama belakangmu agak bikin lidah saya keseleo.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: Kalau begitu, kita mulai sesi wawancaranya, ya.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: 
    expressionSprite: {fileID: 0}
    isDecisionPoint: 1
    questionTitle: 
    choices:
    - choiceText: Di CV kamu tertulis kamu punya keinginan leadership yang tinggi,
        apa buktinya?
      scoreWeight: 25
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Di CV kamu tertulis kalau kamu punya jiwa leadership yang cukup
          kuat.
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Boleh ceritakan apa yang membuat kamu yakin soal itu? Mungkin
          dari pengalaman atau situasi di mana kamu pernah memimpin orang lain?
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Dulu waktu SMP, saya pernah menjadi ketua OSIS!
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Selain itu, sejak sekitar empat tahun lalu saya juga memimpin
          sebuah grup otomotif. Jadi, saya sudah cukup terbiasa mengatur anggota,
          membagi tugas, dan mengambil keputusan.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Yaaap! Kurang lebih itu bukti kalau saya memang punya jiwa
          leadership, hehe.
        expressionSprite: {fileID: 0}
    - choiceText: Kamu bilang kamu itu multitalenta, coba jelaskan?
      scoreWeight: 15
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Di awal tadi kamu bilang kalau kamu punya banyak talenta.
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Boleh jelaskan lebih spesifik? Sebenarnya kamu menguasai bidang
          apa saja?
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Yap! Saya punya pengalaman di berbagai bidang. Mulai dari bisnis,
          fisika, kimia, otomotif...
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: ...senjata juga.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: E-eh, maksud saya... pokoknya cukup banyak! Semuanya sudah
          saya cantumkan di CV, kok!
        expressionSprite: {fileID: 0}
    - choiceText: Apakah kamu bersedia mengerjakan pekerjaan teman kerjamu jika diminta?
      scoreWeight: 10
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Kalau suatu saat ada rekan kerja yang meminta bantuan karena
          pekerjaannya belum selesai, apakah kamu bersedia membantu mengerjakan bagiannya?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Kalau iya, sampai sejauh mana kamu bersedia membantu?
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Yap, tentu saja! Tapi tetap tergantung seberapa kompleks pekerjaannya,
          ya.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Kalau memang masih dalam kemampuan saya, saya pasti akan coba
          bantu. Kalau belum paham... ya, saya pelajari dulu!
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Pokoknya sebisa mungkin saya nggak akan membiarkan teman saya
          kesulitan sendirian.
        expressionSprite: {fileID: 0}
  - speakerName: Rookie
    dialogueText: Oke, menarik...
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: Kalau begitu, Alstena, kita lanjut ke pertanyaan berikutnya.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: 
    expressionSprite: {fileID: 0}
    isDecisionPoint: 1
    questionTitle: 
    choices:
    - choiceText: Kalau ada satu hal dari diri kamu yang ingin kamu ubah atau perbaiki,
        kira-kira apa?
      scoreWeight: 15
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Kalau ada satu hal dari diri kamu yang ingin kamu ubah atau
          perbaiki, kira-kira apa?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Dan kenapa kamu memilih hal itu?
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Hmm... sejujurnya, tidak ada.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Saat ini saya sudah merasa cukup dengan diri saya sendiri.
          Bukan berarti saya merasa sempurna, ya! Saya hanya tidak merasa ada sesuatu
          yang harus saya ubah secara paksa.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Kalau nanti seiring berjalannya waktu saya memang perlu berubah
          atau berkembang... ya, saya akan menerimanya dan berusaha menyesuaikan
          diri!
        expressionSprite: {fileID: 0}
    - choiceText: Kamu menulis kalau salah satu hobimu berkaitan dengan senjata.
        Bisa ceritakan sedikit maksudnya seperti apa?
      scoreWeight: 10
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Hmm... ada satu hal yang cukup menarik perhatian saya di CV
          kamu.
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Kamu menulis kalau salah satu hobimu berkaitan dengan senjata.
          Bisa ceritakan sedikit maksudnya seperti apa?
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Yap! Awalnya karena saya memang sering main game FPS selama
          beberapa tahun.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Lalu saya juga pernah mengikuti kegiatan bela negara. Dari
          situ saya mulai tertarik dan hobi mempelajari hal-hal yang berkaitan dengan
          senjata.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Kurang lebih... dari situlah awal mulanya!
        expressionSprite: {fileID: 0}
    - choiceText: Kalau kamu harus memilih satu bidang untuk benar-benar kamu tekuni
        di sini, bidang apa yang akan kamu pilih? Dan kenapa?
      scoreWeight: 25
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Kamu punya kemampuan di banyak bidang, tapi tentu perusahaan
          ini tidak mungkin bisa memanfaatkan semuanya sekaligus.
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Kalau kamu harus memilih satu bidang untuk benar-benar kamu
          tekuni di sini, bidang apa yang akan kamu pilih? Dan kenapa?
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Kalau melihat kondisi perusahaan saat ini yang masih agak...
          kacau, ditambah lokasinya yang cukup terpencil...
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Saya rasa kemampuan saya akan paling berguna kalau ditempatkan
          sebagai supervisor keamanan.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Saya cukup yakin bisa menjaga keamanan sekaligus mengatur tim
          dengan baik. Yap! Itu pilihan saya!
        expressionSprite: {fileID: 0}
  - speakerName: Rookie
    dialogueText: O-oke... Baiklah.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: Kalau begitu, Alstena... sekarang kita masuk ke pertanyaan terakhir.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: 
    expressionSprite: {fileID: 0}
    isDecisionPoint: 1
    questionTitle: 
    choices:
    - choiceText: Pakaianmu... inspirasinya dari mana? tentunya ini adalah pekerjaan
        korporat, jadi saya agak bingung...
      scoreWeight: 10
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Saya agak penasaran dengan pakaianmu.
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Gaya seperti itu sebenarnya terinspirasi dari mana? Soalnya...
          ini lingkungan kerja korporat, jadi saya agak bingung melihat pilihan outfit
          kamu.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Ah, ini terinspirasi dari seorang penjaga di tempat saya!
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Dia selalu memakai helm ke mana pun dia pergi. Orangnya juga
          baik dan sering membantu orang lain yang sedang kesulitan.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Saya cukup kagum dengannya, jadi... saya rasa gaya saya sedikit
          banyak terinspirasi dari dia. Yap!
        expressionSprite: {fileID: 0}
    - choiceText: Apa ada pengalaman lain yang belum sempat kamu ceritakan?
      scoreWeight: 15
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Apa ada pengalaman lain yang belum sempat kamu ceritakan?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Mungkin sesuatu yang menurutmu cukup penting dan bisa menjadi
          pertimbangan bagi kami?
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Dulu, selama bekerja serabutan, saya bertemu dengan banyak
          orang dari berbagai macam keadaan.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Ada yang hidupnya berkecukupan, ada juga yang harus berjuang
          keras hanya untuk menjalani hari.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Melihat semua itu membuat saya sadar kalau saya ingin melakukan
          sesuatu yang lebih berarti. Saya ingin berkontribusi pada sesuatu yang
          lebih besar, bukan hanya untuk diri saya sendiri.
        expressionSprite: {fileID: 0}
    - choiceText: Kandidat lain dalam keadaan susah, dan pekerjaan ini adalah satu
        satunya harapan mereka, apa yang akan kamu lakukan?
      scoreWeight: 25
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Misalnya ada kandidat lain yang sedang berada dalam kondisi
          sulit, dan pekerjaan ini adalah satu-satunya harapan mereka untuk memperbaiki
          keadaan.
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Kalau kamu mengetahui hal itu, sementara kamu sendiri juga
          menginginkan posisi ini... apa yang akan kamu lakukan?
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Bagi saya, menolong seseorang itu adalah salah satu hal terpenting
          dalam hidup.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Pekerjaan ini memang berharga bagi saya. Tapi kalau bagi orang
          itu pekerjaan ini benar-benar menyangkut hidup dan matinya... saya akan
          memilih untuk mundur.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Walaupun keputusan itu merugikan saya, perusahaan ini akan
          tetap berjalan tanpa saya. Sedangkan bagi dia, kesempatan ini mungkin bisa
          mengubah hidupnya.
        expressionSprite: {fileID: 0}
      - speakerName: Alstena Reszwki
        dialogueText: Kalau akhirnya keadaan dia bisa membaik karena itu... saya
          rasa saya juga akan ikut senang.
        expressionSprite: {fileID: 0}
  - speakerName: Rookie
    dialogueText: Baik... saya rasa cukup sampai di sini.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: Ini sesi wawancara yang cukup menarik, Alstena. Terima kasih sudah
      menjawab semua pertanyaan dengan baik.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: Kami akan mempertimbangkan hasil wawancara ini. Semoga kita bisa
      bertemu lagi.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
