  m_EditorClassIdentifier: Assembly-CSharp::GT.Dialogue.Data.CandidateInterviewScriptSO
  candidateId: worker_5
  candidateName: Nathania Alietashya
  candidateBio: Pemalu, tidak malas tidak pula rajin, cepat dalam pekerjaan, tsundere
  defaultPortrait: {fileID: 2607499583252603074, guid: d50bd8bfa2cbd29488a4fe5a10023e85, type: 3}
  cvDocumentSprite: {fileID: -6177258175572825773, guid: d332540b80c8a4449b91e8bc08c774a0, type: 3}
  dialogueLines:
  - speakerName: Nathania Alietashya
    dialogueText: Halo... perkenalkan, saya Nathania Alietashya.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Nathania Alietashya
    dialogueText: Saya banyak berkecimpung di bidang seni dan desain. Senang bisa
      mendapat kesempatan untuk wawancara di sini hari ini.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Nathania Alietashya
    dialogueText: Mohon bantuannya.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: Baik, Nathania. Kalau begitu, kita mulai sesi wawancaranya, ya.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: Saya akan mengajukan beberapa pertanyaan untuk mengenal kamu dan
      cara kerjamu lebih jauh.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: 
    expressionSprite: {fileID: 0}
    isDecisionPoint: 1
    questionTitle: 
    choices:
    - choiceText: Kalau kamu diminta menyebutkan satu keunggulan yang paling kamu
        percaya dari dirimu, apa itu?
      scoreWeight: 25
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Kalau kamu diminta menyebutkan satu keunggulan yang paling
          kamu percaya dari dirimu, apa itu?
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Saya cukup responsif dan cepat dalam menghadapi berbagai situasi.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Biasanya saya bisa memahami apa yang perlu dilakukan dan langsung
          mengerjakannya lebih cepat dibanding kebanyakan orang... termasuk kolega
          saya sendiri.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: B-bukan bermaksud menyombongkan diri, ya. Memang biasanya seperti
          itu.
        expressionSprite: {fileID: 0}
    - choiceText: Menurut kamu sendiri, apa kelemahan terbesar yang kamu punya dalam
        bekerja?
      scoreWeight: 15
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: 
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Sejujurnya... saya agak pemalu. Ada beberapa situasi yang membuat
          saya merasa canggung, terutama kalau harus berhadapan dengan orang baru.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Tapi saya selalu berusaha melewatinya. Saya tidak mau rasa
          canggung itu sampai mengganggu pekerjaan saya.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Jadi... ya, saya masih belajar membiasakan diri
        expressionSprite: {fileID: 0}
    - choiceText: Kalau boleh tahu, apa yang membuat kamu tertarik untuk bergabung
        dengan perusahaan ini?
      scoreWeight: 10
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Kalau boleh tahu, apa yang membuat kamu tertarik untuk bergabung
          dengan perusahaan ini?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Dari sekian banyak tempat yang bisa kamu pilih, kenapa kamu
          memilih melamar di sini?
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Hmm... karena perusahaan ini masih cukup baru, saya melihat
          masih banyak potensi yang bisa dikembangkan.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Saya tertarik untuk ikut tumbuh bersama perusahaan ini dan,
          kalau bisa, membantu lewat kemampuan saya di bidang seni dan desain.
        expressionSprite: {fileID: 0}
  - speakerName: Rookie
    dialogueText: Baik, Nathania. Terima kasih atas jawabannya.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: Kalau begitu, kita lanjut ke pertanyaan berikutnya, ya.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: 
    expressionSprite: {fileID: 0}
    isDecisionPoint: 1
    questionTitle: 
    choices:
    - choiceText: Kalau suatu saat perusahaan meminta kamu mengerjakan sesuatu di
        luar bidang seni dan desain, bagaimana kamu akan menanggapinya?
      scoreWeight: 15
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Kalau suatu saat perusahaan meminta kamu mengerjakan sesuatu
          di luar bidang seni dan desain, bagaimana kamu akan menanggapinya?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Apakah kamu bersedia mengambil tanggung jawab di luar spesialisasimu?
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Saya rasa... saya akan menerimanya dan mencoba mengerjakannya
          sebisa mungkin.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Kalau memang ada hal yang belum saya pahami, saya akan pelajari
          dulu. Selama masih bisa saya kerjakan, saya tidak keberatan mencoba sesuatu
          di luar bidang saya.
        expressionSprite: {fileID: 0}
    - choiceText: Jadi, sekadar untuk memastikan... sebenarnya kamu ini femboy atau
        tomboy?
      scoreWeight: 10
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Perusahaan kami tentunya menghargai keberagaman di antara para
          karyawan.
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Jadi, sekadar untuk memastikan... sebenarnya kamu ini femboy
          atau tomboy?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: H-heeeehhh?!
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Anu... Mas, jadi begini... coba diperhatikan lagi baik-baik.
          Di CV saya sudah tertulis jelas, kan...?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Kenapa malah tanya langsung begitu sih... b-baka...
        expressionSprite: {fileID: 0}
    - choiceText: Menurut kamu, dengan kondisi perusahaan saat ini, apakah kita bisa
        terus berada di posisi yang aman?
      scoreWeight: 25
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Menurut kamu, dengan kondisi perusahaan saat ini, apakah kita
          bisa terus berada di posisi yang aman?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Atau ada sesuatu yang menurutmu perlu mulai kita waspadai?
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Sejujurnya... tidak. Menurut saya, kondisi perusahaan saat
          ini belum bisa dibilang aman.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Arah marketing, branding, bahkan profil perusahaannya sendiri
          masih belum terlihat jelas.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Tapi... justru itu yang membuat saya tertarik. Saya yakin dengan
          kemampuan yang saya punya, saya bisa membantu membalik keadaan.
        expressionSprite: {fileID: 0}
  - speakerName: Rookie
    dialogueText: Baiklah, Nathania. Sepertinya kita sudah sampai di penghujung wawancara.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: Sekarang, satu pertanyaan terakhir...
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
  - speakerName: Rookie
    dialogueText: 
    expressionSprite: {fileID: 0}
    isDecisionPoint: 1
    questionTitle: 
    choices:
    - choiceText: Nathania, tipe kamu itu apa ya?
      scoreWeight: 10
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Nathania... boleh saya tanya sesuatu yang sedikit di luar topik
          pekerjaan?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Sebenarnya tipe yang kamu suka itu seperti apa?
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: H-heeehhh?! A-anu... kenapa tiba-tiba tanya begitu?!
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: E-eh... tipe saya itu... p-pokoknya...
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: B-bukan kamu! Jelas bukan kamu!
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: ...Heee-heee... a-aduh, kenapa saya malah jawab begini sih...
        expressionSprite: {fileID: 0}
    - choiceText: Nathania, kalau kamu harus bekerja dalam sebuah tim dengan tugas
        yang berbeda-beda dan deadline yang cukup ketat, apakah kamu sanggup menghadapinya?
      scoreWeight: 15
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Nathania, kalau kamu harus bekerja dalam sebuah tim dengan
          tugas yang berbeda-beda dan deadline yang cukup ketat, apakah kamu sanggup
          menghadapinya?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Bagaimana biasanya kamu menyesuaikan diri dalam situasi seperti
          itu?
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Dengan kemampuan saya saat ini, saya rasa saya sanggup.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Selama pembagian tugas dan deadline-nya jelas, saya bisa menyesuaikan
          diri dan menyelesaikan bagian saya tepat waktu.
        expressionSprite: {fileID: 0}
    - choiceText: Nathania, kalau kamu diterima di sini dan diberi kesempatan untuk
        mengubah satu hal dari perusahaan ini, apa yang ingin kamu ubah?
      scoreWeight: 25
      reactionText: 
      reactionSprite: {fileID: 0}
      followUpDialogue:
      - speakerName: Rookie
        dialogueText: Nathania, kalau kamu diterima di sini dan diberi kesempatan
          untuk mengubah satu hal dari perusahaan ini, apa yang ingin kamu ubah?
        expressionSprite: {fileID: 0}
      - speakerName: Rookie
        dialogueText: Jelaskan juga kenapa kamu memilih hal tersebut.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Kamu.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Cara pandang kamu soal branding perusahaan masih terasa sangat...
          blur. Padahal kamu leader-nya, jadi seharusnya kamu punya arah yang lebih
          jelas.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: T-tapi bukan berarti semuanya buruk, ya! Justru karena itu...
          saya ingin membantu.
        expressionSprite: {fileID: 0}
      - speakerName: Nathania Alietashya
        dialogueText: Kalau saya diterima, saya akan bantu kamu membangun branding
          perusahaan ini sampai punya identitas yang lebih kuat!
        expressionSprite: {fileID: 0}
  - speakerName: Rookie
    dialogueText: Baiklah... saya rasa cukup sampai di sini, Nathania. Terima kasih
      atas jawabannya.
    expressionSprite: {fileID: 0}
    isDecisionPoint: 0
    questionTitle: 
    choices: []
